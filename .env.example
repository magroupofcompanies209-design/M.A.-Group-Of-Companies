# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_AI_API_KEY"

# APP_URL: Host URL
APP_URL="MY_APP_URL"

# Database Configuration (Supabase / PostgreSQL)
# Option A: Supabase API (Recommended for persistent products table & storage)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Option B: Direct PostgreSQL connection string
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Authentication & Session Secrets
AUTH_SECRET="your_production_auth_secret_token_change_in_prod"

# Admin Master Secret: Private secret used only on the backend for administrator authorization
ADMIN_MASTER_SECRET=your_actual_secret_here

# Object Storage Configuration (S3 / Cloud Storage)
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

